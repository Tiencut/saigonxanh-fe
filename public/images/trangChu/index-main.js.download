NHÌN"}),S.jsx("span",{className:"text-1D2130 font-light text-sm sm:text-base",children:"Chúng tôi hướng tới việc biến Việt Nam trở thành quốc gia điển hình trong việc bảo vệ môi trường, bắt đầu từ việc cải thiện chất lượng môi trường nước tại Sài Gòn. Chúng tôi mong muốn rằng những hành động của chúng tôi sẽ tạo ra một làn sóng bảo vệ môi trường lan rộng trên khắp đất nước, và sau đó, toàn cầu. Chúng tôi khát vọng sẽ tạo nên một thế hệ trẻ toàn cầu, biết trân trọng và có trách nhiệm với môi trường, cùng nhau xây dựng một hành tinh xanh, bền vững và thân thiện."})]}),S.jsxs("div",{className:"flex flex-col gap-2 max-w-[500px]",children:[S.jsx("span",{className:"text-1D2130 font-bold text-base",children:"SỨ MỆNH"}),S.jsx("span",{className:"text-1D2130 font-light text-sm sm:text-base",children:"Sài Gòn Xanh cam kết không chỉ thu gom rác và tái chế chất thải từ các con sông ở Sài Gòn, mà còn nỗ lực thay đổi nhận thức của cộng đồng về tầm quan trọng của việc bảo vệ môi trường. Qua việc kêu gọi và thúc đẩy hành động cộng đồng về sự bền vững, chúng tôi muốn mở rộng ảnh hưởng của mình ra khắp Việt Nam và thế giới."})]})]}),S.jsxs("div",{children:[S.jsx("span",{className:"text-1D2130 font-bold text-base uppercase",children:"CÁC NỀN TẢNG Mạng xã hội"}),S.jsx("div",{className:"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-6 mt-5",children:Bee.map((r,i)=>S.jsxs(It,{to:r.url||"",target:"blank",className:"flex flex-col justify-between items-center gap-4",children:[S.jsx("img",{src:r.icon||"/placeholder.svg",width:60,height:60,alt:`${r.label} icon`,className:"w-auto h-auto"}),S.jsx("span",{className:"uppercase font-medium text-xs sm:text-sm text-primary text-center",children:r.label})]},i))})]}),S.jsxs("div",{className:"mb-14",children:[S.jsx("span",{className:"text-1D2130 font-bold text-base uppercase",children:"CÁC NỀN TẢNG ỨNG DỤNG"}),S.jsx("div",{className:"flex flex-col sm:flex-row justify-between mt-5 gap-6",children:qee.map((r,i)=>S.jsxs("div",{className:"flex gap-5 lg: